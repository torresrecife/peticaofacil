APP_NAME="Peticao Facil"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://bvaa.test/peticaofacil
APP_TIMEZONE=America/Sao_Paulo

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=peticaofacil_laravel
DB_USERNAME=root
DB_PASSWORD=root
DB_CHARSET=latin1
DB_COLLATION=latin1_swedish_ci

SQLSRV_HOST=127.0.0.1
SQLSRV_PORT=1433
SQLSRV_DATABASE=
SQLSRV_USERNAME=
SQLSRV_PASSWORD=
SQLSRV_CHARSET=UTF-8

WORD_IMPORT_BINARY="C:\Program Files\LibreOffice\program\soffice.exe"
WORD_IMPORT_TIMEOUT=60
OPENAI_ENABLED=true
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6
OPENAI_TIMEOUT=60
LANGUAGETOOL_ENABLED=false
LANGUAGETOOL_BASE_URL=http://127.0.0.1:8081
LANGUAGETOOL_LANGUAGE=pt-BR
LANGUAGETOOL_TIMEOUT=20
LANGUAGETOOL_USERNAME=
LANGUAGETOOL_API_KEY=
PDF_ENGINE=browser
PDF_FALLBACK_ENGINE=html2pdf
PDF_BROWSER_BINARY=
PDF_BROWSER_TIMEOUT=60
PDF_BROWSER_VIRTUAL_TIME_BUDGET=4000
PDF_PLAYWRIGHT_NODE_BINARY=node
PDF_PLAYWRIGHT_BROWSER_BINARY=
PDF_PLAYWRIGHT_SCRIPT=
PDF_PLAYWRIGHT_TIMEOUT=90
PDF_PLAYWRIGHT_MARGIN_TOP=16.9mm
PDF_PLAYWRIGHT_MARGIN_RIGHT=16.9mm
PDF_PLAYWRIGHT_MARGIN_BOTTOM=16.9mm
PDF_PLAYWRIGHT_MARGIN_LEFT=16.9mm
PDF_PRINT_MARGIN_TOP_MM=19
PDF_PRINT_MARGIN_RIGHT_MM=17
PDF_PRINT_MARGIN_BOTTOM_MM=15
PDF_PRINT_MARGIN_LEFT_MM=17

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
