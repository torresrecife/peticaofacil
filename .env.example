APP_NAME="Peticao Facil"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://bvaa.test/peticaofacil

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=peticaofacil_laravel
DB_USERNAME=root
DB_PASSWORD=root
DB_CHARSET=latin1
DB_COLLATION=latin1_swedish_ci

SQLSRV_HOST=127.0.0.1
SQLSRV_PORT=1433
SQLSRV_DATABASE=
SQLSRV_USERNAME=
SQLSRV_PASSWORD=
SQLSRV_CHARSET=UTF-8

LEGACY_APP_URL=http://bvaa.test/peticaofacil
LEGACY_CKFINDER_ROOT=C:/laragon/www/bvaa/peticaofacil/public/ckfinder/userfiles/
LEGACY_CKFINDER_BASE_URL=/peticaofacil/ckfinder/userfiles/
LEGACY_PECAS_MIRROR=false
LEGACY_MODELOS_MIRROR=false
LEGACY_LISTAS_MIRROR=false
LEGACY_SQL_CONFIGS_MIRROR=false
LEGACY_USERS_MIRROR=false
LEGACY_USERS_AUTH_FALLBACK=false

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
